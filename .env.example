# ACM Shark Tank Event Operations Platform - Environment Variables Template

# Database Connection (Neon DB Serverless or Local PostgreSQL)
# Example Neon connection string:
# DATABASE_URL=postgresql://neondb_owner:npg_password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acm_shark_tank

# Security & JWT
JWT_SECRET=super_secret_acm_shark_tank_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Settings
ENVIRONMENT=development

# Backend URL & API Base
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Allowed CORS Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
